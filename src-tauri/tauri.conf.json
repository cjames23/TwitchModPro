{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Twitch Mod Pro",
  "version": "0.1.0",
  "identifier": "com.twitchmodpro.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Twitch Mod Pro",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "shortDescription": "Multi-chat moderation tool for Twitch",
    "category": "Utility",
    "resources": {
      "resources/toxicity/": "toxicity/"
    }
  }
}
